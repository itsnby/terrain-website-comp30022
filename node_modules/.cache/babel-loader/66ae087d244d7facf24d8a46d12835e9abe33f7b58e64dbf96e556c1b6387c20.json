{"ast":null,"code":"import{useState,useEffect}from\"react\";const useMousePosition=()=>{const[position,setPosition]=useState({clientX:0,clientY:0});const updatePosition=event=>{const{pageX,pageY,clientX,clientY}=event;setPosition({clientX,clientY});};useEffect(()=>{document.addEventListener(\"mousemove\",updatePosition,false);document.addEventListener(\"mouseenter\",updatePosition,false);return()=>{document.removeEventListener(\"mousemove\",updatePosition);document.removeEventListener(\"mouseenter\",updatePosition);};},[]);return position;};export default useMousePosition;","map":{"version":3,"names":["useState","useEffect","useMousePosition","position","setPosition","clientX","clientY","updatePosition","event","pageX","pageY","document","addEventListener","removeEventListener"],"sources":["/Users/cristinanapoleone/Dropbox/TERRAIN Projects/Branding, Web, Graphic Design & Social Media/Website/staging-terrain/src/components/Cursor/useMousePosition.js"],"sourcesContent":["import { useState, useEffect } from \"react\";\n\nconst useMousePosition = () => {\n  const [position, setPosition] = useState({\n    clientX: 0,\n    clientY: 0,\n  });\n\n  const updatePosition = (event) => {\n    const { pageX, pageY, clientX, clientY } = event;\n\n    setPosition({\n      clientX,\n      clientY,\n    });\n  };\n\n  useEffect(() => {\n    document.addEventListener(\"mousemove\", updatePosition, false);\n    document.addEventListener(\"mouseenter\", updatePosition, false);\n\n    return () => {\n      document.removeEventListener(\"mousemove\", updatePosition);\n      document.removeEventListener(\"mouseenter\", updatePosition);\n    };\n  }, []);\n\n  return position;\n};\n\nexport default useMousePosition;\n"],"mappings":"AAAA,OAASA,QAAQ,CAAEC,SAAS,KAAQ,OAAO,CAE3C,KAAM,CAAAC,gBAAgB,CAAGA,CAAA,GAAM,CAC7B,KAAM,CAACC,QAAQ,CAAEC,WAAW,CAAC,CAAGJ,QAAQ,CAAC,CACvCK,OAAO,CAAE,CAAC,CACVC,OAAO,CAAE,CACX,CAAC,CAAC,CAEF,KAAM,CAAAC,cAAc,CAAIC,KAAK,EAAK,CAChC,KAAM,CAAEC,KAAK,CAAEC,KAAK,CAAEL,OA